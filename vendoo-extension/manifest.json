{
  "manifest_version": 3,
  "name": "Vendoo Listing Studio Bridge",
  "version": "0.2.2",
  "description": "Connect Vendoo Listing Studio to automate marketplace listing drafts",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://app.vendoo.co/*",
    "https://web.vendoo.co/*",
    "https://www.ebay.com/*",
    "https://poshmark.com/*",
    "https://www.mercari.com/*",
    "https://www.depop.com/*",
    "https://www.etsy.com/*",
    "http://127.0.0.1:4318/*",
    "ws://127.0.0.1:4318/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.vendoo.co/*", "https://web.vendoo.co/*"],
      "js": ["content-scripts/vendoo.js"]
    },
    {
      "matches": ["https://www.ebay.com/*"],
      "js": ["content-scripts/ebay.js"]
    },
    {
      "matches": ["https://poshmark.com/*"],
      "js": ["content-scripts/poshmark.js"]
    },
    {
      "matches": ["https://www.mercari.com/*"],
      "js": ["content-scripts/mercari.js"]
    },
    {
      "matches": ["https://www.depop.com/*"],
      "js": ["content-scripts/depop.js"]
    },
    {
      "matches": ["https://www.etsy.com/*"],
      "js": ["content-scripts/etsy.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
